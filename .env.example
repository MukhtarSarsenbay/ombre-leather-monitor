# This URL is the 50 ml bottle, verified against the product page.
PRODUCT_URL=https://goldapple.kz/26375200001-ombre-leather
MONAMIE_URL=https://www.monamie.kz/catalog/dlya_muzhchin/muzhskie_aromaty/tom_ford_ombr_leather_parfyumirovannaya_voda_id74160/
EXPECTED_VOLUME_ML=50
THRESHOLD_KZT=71000
# all, goldapple, or monamie; --store overrides this for CLI runs.
CHECK_STORE=all
NOTIFICATION_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Required only for authenticated FastAPI endpoints. Use a random long value.
API_TOKEN=
# Leave empty on Linux after installing Playwright Chromium; use chrome on macOS.
BROWSER_CHANNEL=
# Mon Amie requires a headed browser. Linux runs it under xvfb-run.
MONAMIE_HEADLESS=false
# Email alternative (SMTP with STARTTLS):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
